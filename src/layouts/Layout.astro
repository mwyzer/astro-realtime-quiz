---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Aplikasi Kuis Realtime Multi-pemain dengan Arsitektur Neo-Brutalist Arcade' } = Astro.props;
---

<!doctype html>
<html lang="id" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | AstroQuiz Live</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Space+Grotesk:wght@700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#0b0f19] text-slate-100 min-h-screen flex flex-col font-['Plus_Jakarta_Sans',sans-serif] selection:bg-amber-400 selection:text-slate-950 antialiased">
    <!-- Navbar Neo-Brutalist Arcade -->
    <header class="border-b-2 border-black bg-[#111827] sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group" aria-label="Beranda AstroQuiz Live">
          <div class="w-9 h-9 rounded-lg bg-amber-400 text-slate-950 font-['Space_Grotesk',sans-serif] font-black flex items-center justify-center border-2 border-black shadow-[2px_2px_0px_#000] group-hover:translate-x-0.5 group-hover:translate-y-0.5 transition-transform">
            <span class="text-sm tracking-tighter leading-none select-none">AQ</span>
          </div>
          <div>
            <span class="font-['Space_Grotesk',sans-serif] font-black text-xl text-white tracking-tight">
              AstroQuiz<span class="text-amber-400">Live</span>
            </span>
          </div>
        </a>

        <nav class="flex items-center gap-2 sm:gap-3 text-sm font-bold" aria-label="Navigasi Utama">
          <a 
            href="/bank" 
            class="px-3 py-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 border-2 border-transparent hover:border-black transition-all"
          >
            Bank Soal
          </a>
          <a 
            href="/play" 
            class="px-3.5 py-2 rounded-lg text-slate-100 bg-[#1e293b] hover:bg-[#2b394e] border-2 border-black shadow-[2px_2px_0px_#000] transition-all"
          >
            Gabung Main
          </a>
          <a 
            href="/host" 
            class="px-4 py-2 rounded-lg text-slate-950 bg-amber-400 hover:bg-amber-300 border-2 border-black shadow-[3px_3px_0px_#000] font-black transition-all active:translate-x-0.5 active:translate-y-0.5 active:shadow-[1px_1px_0px_#000]"
          >
            Buka Room Host
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer Neo-Brutalist Arcade -->
    <footer class="border-t-2 border-black bg-[#0d121f] py-6 text-xs text-slate-400">
      <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="font-medium">
          AstroQuiz Live: Platform Kuis Interaktif Realtime berbasis Astro, React Islands, dan WebSockets.
        </p>
        <div class="flex items-center gap-4 text-slate-300 font-mono text-xs font-bold">
          <a href="/host" class="hover:text-amber-400 transition-colors">Host</a>
          <a href="/play" class="hover:text-amber-400 transition-colors">Peserta</a>
          <a href="/bank" class="hover:text-amber-400 transition-colors">Bank Soal</a>
        </div>
      </div>
    </footer>

    <style is:global>
      .font-display {
        font-family: 'Space Grotesk', sans-serif;
      }
      .font-mono {
        font-family: 'JetBrains Mono', monospace;
        font-feature-settings: 'tnum';
        font-variant-numeric: tabular-nums;
      }

      /* Neo-Brutalist Utility Classes */
      .arcade-card {
        background: #151c2c;
        border: 2px solid #000000;
        box-shadow: 4px 4px 0px #000000;
        border-radius: 12px;
      }

      .arcade-card-amber {
        background: #facc15;
        color: #020617;
        border: 2px solid #000000;
        box-shadow: 4px 4px 0px #000000;
        border-radius: 12px;
      }

      .arcade-btn {
        border: 2px solid #000000;
        box-shadow: 4px 4px 0px #000000;
        transition: transform 120ms ease, box-shadow 120ms ease;
        cursor: pointer;
      }

      .arcade-btn:hover {
        transform: translate(-1px, -1px);
        box-shadow: 5px 5px 0px #000000;
      }

      .arcade-btn:active {
        transform: translate(2px, 2px);
        box-shadow: 2px 2px 0px #000000;
      }

      /* Isometric Neo-Brutalist Utility Classes */
      .iso-card {
        background: #151c2c;
        border: 2px solid #000000;
        border-bottom-width: 5px;
        border-right-width: 4px;
        box-shadow: 6px 6px 0px #000000;
        border-radius: 14px;
        transition: transform 140ms ease, box-shadow 140ms ease;
      }

      .iso-card:hover {
        transform: translate(-2px, -2px);
        box-shadow: 8px 8px 0px #000000;
      }

      .iso-btn {
        border: 2px solid #000000;
        border-bottom-width: 4px;
        border-right-width: 3px;
        box-shadow: 4px 4px 0px #000000;
        transition: transform 100ms ease, box-shadow 100ms ease;
        cursor: pointer;
      }

      .iso-btn:hover {
        transform: translate(-1px, -1px);
        box-shadow: 6px 6px 0px #000000;
      }

      .iso-btn:active {
        transform: translate(3px, 3px);
        box-shadow: 1px 1px 0px #000000;
      }

      .iso-tile {
        position: relative;
        border: 2px solid #000000;
        border-bottom-width: 6px;
        border-right-width: 5px;
        box-shadow: 5px 5px 0px #000000;
        border-radius: 14px;
        transition: transform 120ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 120ms ease;
        cursor: pointer;
      }

      .iso-tile:hover {
        transform: translate(-2px, -2px);
        box-shadow: 7px 7px 0px #000000;
      }

      .iso-tile:active {
        transform: translate(3px, 3px);
        box-shadow: 1px 1px 0px #000000;
      }

      .iso-stage {
        transform: rotateX(55deg) rotateZ(-45deg);
        transform-style: preserve-3d;
      }

      .iso-grid-floor {
        background-color: #0b0f19;
        background-image: 
          linear-gradient(30deg, rgba(250, 204, 21, 0.05) 12%, transparent 12.5%, transparent 87%, rgba(250, 204, 21, 0.05) 87.5%, rgba(250, 204, 21, 0.05)),
          linear-gradient(150deg, rgba(250, 204, 21, 0.05) 12%, transparent 12.5%, transparent 87%, rgba(250, 204, 21, 0.05) 87.5%, rgba(250, 204, 21, 0.05)),
          linear-gradient(30deg, rgba(250, 204, 21, 0.05) 12%, transparent 12.5%, transparent 87%, rgba(250, 204, 21, 0.05) 87.5%, rgba(250, 204, 21, 0.05)),
          linear-gradient(150deg, rgba(250, 204, 21, 0.05) 12%, transparent 12.5%, transparent 87%, rgba(250, 204, 21, 0.05) 87.5%, rgba(250, 204, 21, 0.05));
        background-size: 40px 70px;
        background-position: 0 0, 0 0, 20px 35px, 20px 35px;
      }

      /* Accessible focus states */
      :focus-visible {
        outline: 2px solid #facc15 !important;
        outline-offset: 2px !important;
      }

      /* Reduced motion support */
      @media (prefers-reduced-motion: reduce) {
        *,
        ::before,
        ::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </body>
</html>
