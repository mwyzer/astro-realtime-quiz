---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Aplikasi Kuis Real-time Multi-pemain dibangun dengan Astro dan React Islands' } = Astro.props;
---

<!doctype html>
<html lang="id" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | AstroQuiz Live</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-['Plus_Jakarta_Sans',sans-serif] selection:bg-purple-500 selection:text-white">
    {/* Navigation */}
    <header class="border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-purple-600 via-pink-500 to-amber-400 flex items-center justify-center shadow-lg shadow-purple-500/20 group-hover:scale-105 transition-transform">
            <span class="text-xl">⚡</span>
          </div>
          <div>
            <span class="font-extrabold text-lg text-white tracking-tight">AstroQuiz<span class="text-purple-400">Live</span></span>
          </div>
        </a>

        <nav class="flex items-center gap-2 sm:gap-4 text-sm font-semibold">
          <a href="/bank" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/60 transition-colors">
            Bank Soal
          </a>
          <a href="/play" class="px-3.5 py-1.5 rounded-lg text-purple-300 bg-purple-500/10 hover:bg-purple-500/20 border border-purple-500/20 transition-all">
            📱 Gabung Main
          </a>
          <a href="/host" class="px-4 py-1.5 rounded-lg text-white bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 shadow-md shadow-purple-600/20 transition-all">
            🎯 Host Kuis
          </a>
        </nav>
      </div>
    </header>

    {/* Main Content */}
    <main class="flex-1">
      <slot />
    </main>

    {/* Footer */}
    <footer class="border-t border-slate-900 bg-slate-950/60 py-8 text-center text-xs text-slate-500">
      <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>© 2026 AstroQuiz Live • Dibangun dengan <span class="text-purple-400 font-bold">Astro</span> + <span class="text-blue-400 font-bold">React Islands</span></p>
        <div class="flex items-center gap-4 text-slate-400">
          <span>Islands Architecture</span>
          <span>•</span>
          <span>WebSocket Realtime</span>
          <span>•</span>
          <span>Tailwind CSS</span>
        </div>
      </div>
    </footer>
  </body>
</html>
