---
import Layout from '../layouts/Layout.astro';
import { DEFAULT_QUIZZES } from '../data/default-quizzes';
---

<Layout title="Beranda | Platform Kuis Realtime Neo-Brutalist Arcade">
  <!-- Hero Section Asimetris 2 Kolom -->
  <section class="py-12 sm:py-16 border-b-2 border-black bg-[#0b0f19]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        <!-- Kolom Kiri: Copywriting Tegas & Aksi Utama -->
        <div class="lg:col-span-7 text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#151c2c] border-2 border-black shadow-[2px_2px_0px_#000] text-amber-400 text-xs font-mono font-bold rounded-md mb-4">
            <span>SOCKET V2 ONLINE</span>
            <span class="text-slate-400">•</span>
            <span>MULTI-ARENA 3D</span>
          </div>

          <h1 class="font-['Space_Grotesk',sans-serif] text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.08] mb-5">
            Kuis Realtime Taktil dengan <span class="text-amber-400 underline decoration-black decoration-4">Arena 3D Roblox</span>
          </h1>

          <p class="text-slate-300 text-base sm:text-lg max-w-xl mb-8 leading-relaxed font-medium">
            Tinggalkan kuis slide datar yang membosankan. Kendalikan karakter blocky 3D di arena interaktif: estafet bom waktu, tebak jembatan kaca, dan hindari lautan lava bersama seluruh peserta.
          </p>

          <div class="flex flex-wrap items-center gap-3">
            <a 
              href="/host" 
              class="px-6 py-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-base arcade-btn flex items-center gap-2"
            >
              <span>Buka Lobby Host</span>
            </a>

            <a 
              href="/bank" 
              class="px-5 py-3.5 rounded-xl bg-[#151c2c] hover:bg-[#1e293b] text-slate-200 font-bold text-base arcade-btn flex items-center gap-2"
            >
              <span>Kelola Bank Soal</span>
            </a>
          </div>
        </div>

        <!-- Kolom Kanan: Terminal Gabung Cepat (Quick-Join Gamepad) -->
        <div class="lg:col-span-5">
          <div class="arcade-card p-6 sm:p-7 relative bg-[#151c2c]">
            <div class="flex items-center justify-between pb-4 mb-5 border-b-2 border-black">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-red-500 border border-black"></span>
                <span class="w-3 h-3 rounded-full bg-amber-400 border border-black"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500 border border-black"></span>
                <span class="font-mono text-xs font-bold text-slate-300 ml-1">QUICK_CONTROLLER.EXE</span>
              </div>
              <span class="text-[11px] font-mono font-bold bg-[#0b0f19] px-2 py-0.5 rounded border border-black text-amber-400">
                CLIENT V2.4
              </span>
            </div>

            <form action="/play" method="GET" class="space-y-4">
              <div>
                <label for="quick-pin" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5 font-mono">
                  Masukkan PIN Room 6 Digit:
                </label>
                <input 
                  type="text" 
                  id="quick-pin" 
                  name="pin" 
                  maxlength="6"
                  pattern="[0-9]{6}"
                  placeholder="Contoh: 849201" 
                  class="w-full bg-[#0b0f19] border-2 border-black rounded-lg px-4 py-3 text-center text-3xl font-mono font-bold tracking-widest text-amber-400 focus:outline-none focus:ring-0 placeholder:text-slate-700"
                  required
                />
              </div>

              <button 
                type="submit" 
                class="w-full py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-base arcade-btn"
              >
                Gabung ke Room Sekarang
              </button>
            </form>

            <div class="mt-5 pt-4 border-t-2 border-black">
              <p class="text-xs font-bold text-slate-400 mb-2 uppercase tracking-wider font-mono">
                Pilih Jalur Arena:
              </p>
              <div class="grid grid-cols-3 gap-2 text-center text-xs font-bold font-mono">
                <div class="p-2 bg-[#0b0f19] border border-black rounded text-amber-400">
                  💣 Estafet Bom
                </div>
                <div class="p-2 bg-[#0b0f19] border border-black rounded text-blue-400">
                  🌉 Jembatan Kaca
                </div>
                <div class="p-2 bg-[#0b0f19] border border-black rounded text-red-400">
                  🌋 Lantai Lava
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Showcase Mode Arena 3D Asimetris -->
  <section class="py-14 sm:py-20 border-b-2 border-black bg-[#0d121f]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-10 text-left">
        <h2 class="font-['Space_Grotesk',sans-serif] text-3xl sm:text-4xl font-black text-white tracking-tight mb-2">
          3 Mode Arena 3D Realtime
        </h2>
        <p class="text-slate-400 text-sm max-w-2xl font-medium">
          Setiap mode menghadirkan fisika dan dinamika permainan yang berbeda untuk menjaga adrenalin peserta tetap tinggi.
        </p>
      </div>

      <div class="grid lg:grid-cols-12 gap-6">
        <!-- Kartu Utama: Estafet Bom Waktu (Lebar 7 Kolom) -->
        <div class="lg:col-span-7 arcade-card p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden bg-[#151c2c]">
          <div class="flex items-center justify-between gap-3 mb-4">
            <span class="px-3 py-1 bg-red-600 text-white font-mono font-bold text-xs rounded border border-black">
              MODE DEFAULT ARENA
            </span>
            <span class="font-mono text-xs text-amber-400 font-bold">
              SURVIVOR BONUS: +300 PTS
            </span>
          </div>

          <div>
            <h3 class="font-['Space_Grotesk',sans-serif] text-2xl sm:text-3xl font-black text-white mb-3">
              💣 Estafet Bom Waktu (Hot Potato)
            </h3>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6 font-medium">
              Satu peserta memegang bom berdetak kencang di kepalanya. Untuk membuang bom sebelum waktu habis, pemegang bom harus memilih opsi jawaban yang benar atau menabrak peserta lain secara fisik di arena 3D. Saat timer habis, bom meledak dan melontarkan pemegang bom ke udara!
            </p>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-4 border-t-2 border-black font-mono text-xs text-slate-300">
            <div class="p-3 bg-[#0b0f19] border border-black rounded">
              <strong class="text-amber-400 block mb-0.5">Oper Lewat Jawaban</strong>
              Jawab benar untuk mengoper bom otomatis ke lawan.
            </div>
            <div class="p-3 bg-[#0b0f19] border border-black rounded">
              <strong class="text-amber-400 block mb-0.5">Oper Lewat Tabrakan</strong>
              Dekati lawan dalam radius 1.8 unit untuk transfer bom.
            </div>
          </div>
        </div>

        <!-- 2 Kartu Pendamping (Lebar 5 Kolom) -->
        <div class="lg:col-span-5 space-y-6">
          <!-- Kartu Jembatan Kaca -->
          <div class="arcade-card p-6 bg-[#151c2c]">
            <div class="flex items-center justify-between mb-2">
              <h4 class="font-['Space_Grotesk',sans-serif] text-xl font-bold text-white">
                🌉 Jembatan Kaca 3D
              </h4>
              <span class="text-xs font-mono text-blue-400 font-bold bg-[#0b0f19] px-2 py-0.5 rounded border border-black">
                SQUID TRIVIA
              </span>
            </div>
            <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-4 font-medium">
              4 Jalur kaca transparan membentang di atas jurang cyber gelap. Jawaban salah membuat kaca retak dan ambruk, menjatuhkan avatar pemain ke dasar jurang.
            </p>
            <div class="text-[11px] font-mono text-slate-400 bg-[#0b0f19] p-2 rounded border border-black">
              Mekanik: Jalur benar tetap kokoh hingga tebing finish piala emas.
            </div>
          </div>

          <!-- Kartu Lantai Lava -->
          <div class="arcade-card p-6 bg-[#151c2c]">
            <div class="flex items-center justify-between mb-2">
              <h4 class="font-['Space_Grotesk',sans-serif] text-xl font-bold text-white">
                🌋 Lantai Lava 3D
              </h4>
              <span class="text-xs font-mono text-red-400 font-bold bg-[#0b0f19] px-2 py-0.5 rounded border border-black">
                COLOR TILES
              </span>
            </div>
            <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-4 font-medium">
              4 Kuadran warna (Merah, Biru, Kuning, Hijau) mengapung di atas samudra lava mendidih. Berlari ke kuadran pilihan sebelum ubin yang salah runtuh ke dalam lava!
            </p>
            <div class="text-[11px] font-mono text-slate-400 bg-[#0b0f19] p-2 rounded border border-black">
              Mekanik: Platform tengah netral dapat dipakai kembali sebelum jawaban terkunci.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Daftar Paket Kuis Bawaan Siap Pakai -->
  <section class="py-14 sm:py-20 border-b-2 border-black bg-[#0b0f19]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
        <div>
          <h2 class="font-['Space_Grotesk',sans-serif] text-2xl sm:text-3xl font-black text-white tracking-tight">
            Paket Soal Siap Main
          </h2>
          <p class="text-slate-400 text-xs sm:text-sm font-medium mt-1">
            Pilih paket kuis bawaan atau buat soal custom di Bank Soal.
          </p>
        </div>
        <a 
          href="/bank" 
          class="px-4 py-2 rounded-lg bg-[#151c2c] hover:bg-[#1e293b] text-slate-200 font-bold text-xs sm:text-sm arcade-btn"
        >
          Lihat Bank Soal Lengkap
        </a>
      </div>

      <div class="grid md:grid-cols-2 gap-5">
        {DEFAULT_QUIZZES.map((quiz) => (
          <div class="arcade-card p-6 flex flex-col justify-between bg-[#151c2c]">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-mono font-bold text-amber-400 uppercase tracking-wider bg-[#0b0f19] px-2.5 py-1 rounded border border-black">
                  {quiz.category}
                </span>
                <span class="text-xs font-mono font-bold text-slate-300 bg-[#0b0f19] px-2 py-0.5 rounded border border-black">
                  {quiz.questions.length} SOAL
                </span>
              </div>
              <h3 class="font-['Space_Grotesk',sans-serif] text-xl font-bold text-white mb-2">
                {quiz.title}
              </h3>
              <p class="text-slate-300 text-xs sm:text-sm leading-relaxed font-medium">
                {quiz.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t-2 border-black flex items-center justify-between">
              <span class="text-xs text-slate-400 font-mono">Timer: ~15 detik per soal</span>
              <a 
                href="/host" 
                class="px-4 py-2 rounded-lg bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-xs sm:text-sm arcade-btn"
              >
                Mulai di Host
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
